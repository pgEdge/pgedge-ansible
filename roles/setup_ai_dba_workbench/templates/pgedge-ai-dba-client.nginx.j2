# Managed by Ansible. setup_ai_dba_workbench writes this over the site the
# pgedge-ai-dba-client package installs. The locations, proxy headers and
# timeouts follow the packaged site (PostgreSQL License, pgEdge, Inc.); this
# one serves them over HTTPS and proxies to the server on the loopback
# interface, where setup_ai_dba_workbench has it listen.

server {
    listen {{ ai_dba_workbench_port }} ssl;
    server_name _;

    ssl_certificate {{ ai_dba_workbench_tls_cert_file }};
    ssl_certificate_key {{ ai_dba_workbench_tls_key_file }};
    ssl_protocols TLSv1.2 TLSv1.3;

    # A plain HTTP request to this port is answered with nginx's own 497 error,
    # which this turns into a redirect to the same address over HTTPS.
    error_page 497 =301 https://$host:$server_port$request_uri;

    root /usr/share/pgedge/ai-dba-client;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript
               text/xml application/xml application/xml+rss text/javascript;
    gzip_vary on;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
{% if not ai_dba_workbench_tls_generated | bool %}
    # Only with a certificate from the inventory: a browser that has seen this
    # header refuses a self-signed certificate outright, rather than offering
    # to continue past it.
    add_header Strict-Transport-Security "max-age=31536000" always;
{% endif %}

    # The web client's own routes, which it resolves in the browser.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # The REST API. The timeouts allow for a language model's slow answers.
    location /api/ {
        proxy_pass http://127.0.0.1:{{ ai_dba_workbench_server_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 90s;
        proxy_send_timeout 90s;
        proxy_read_timeout 90s;
    }

    # The MCP endpoint, for MCP clients outside this host. The timeouts allow
    # for long-running queries.
    location /mcp/ {
        proxy_pass http://127.0.0.1:{{ ai_dba_workbench_server_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 90s;
        proxy_send_timeout 90s;
        proxy_read_timeout 90s;
    }
}
