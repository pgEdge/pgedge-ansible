# Rocky's own image, which follows the current 9.x release. The Docker Hub
# library image stopped at 9.3, whose PGDG repositories are gone.
FROM rockylinux/rockylinux:9

RUN cat <<EOF > /etc/dnf/dnf.conf
[main]
gpgcheck=1
installonly_limit=3
clean_requirements_on_remove=True
best=True
skip_if_unavailable=False
max_parallel_downloads=10
fastestmirror=True
EOF

RUN dnf -y install systemd openssh-server openssh-clients python3 sudo iproute passwd && \
    dnf clean all

# Fetch EPEL from a fixed list of mirrors instead of Fedora's mirror list.
# The mirror list also accepts the previous days' repomd.xml, and with
# fastestmirror a stale CDN-fronted mirror can win every time. Its index
# names files that every mirror has since pruned, so each one returns 404
# and the run fails. These mirrors sync directly, and dnf tries them in
# order, so dl.fedoraproject.org only serves if both of them fail.
# install_repos finds epel-release already installed and leaves it alone;
# the package marks the file as config, so an upgrade keeps these edits.
RUN dnf -y install epel-release && \
    sed -i '/^\[epel\]/,/^\[/{ s|^metalink=|#metalink=|; s|^#baseurl=.*|baseurl=https://mirrors.kernel.org/fedora-epel/9/Everything/$basearch/ https://ftp-osl.osuosl.org/pub/fedora-epel/9/Everything/$basearch/ https://dl.fedoraproject.org/pub/epel/9/Everything/$basearch/| }' \
        /etc/yum.repos.d/epel.repo && \
    dnf clean all

RUN useradd -m -s /bin/bash ansible && \
    echo 'ansible ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/ansible && \
    chmod 440 /etc/sudoers.d/ansible && \
    mkdir -p /home/ansible/.ssh && \
    chown ansible:ansible /home/ansible/.ssh && \
    chmod 700 /home/ansible/.ssh

# Rocky ships /etc/shadow with mode 0000, which root can read only with a
# capability that bypasses file permissions. On GitHub's Ubuntu 24.04
# runners, the runner's AppArmor unix-chkpwd profile is applied to this
# image's unix_chkpwd, since the privileged containers run without a
# profile of their own, and it does not grant that capability, so
# pam_unix's account check fails and sshd refuses every login. With mode
# 0400 root reads the file as its owner.
RUN chmod 0400 /etc/shadow

COPY authorized_keys /home/ansible/.ssh/authorized_keys
RUN chown ansible:ansible /home/ansible/.ssh/authorized_keys && \
    chmod 600 /home/ansible/.ssh/authorized_keys

RUN ssh-keygen -A && systemctl enable sshd

CMD ["/usr/sbin/init"]
